# Copiá este archivo a `.env` y ajustá lo que necesites:
#   cp .env.example .env
# docker compose lee `.env` automáticamente; sin él usa estos mismos valores.

# Puerto del host donde se publica la web/API (el contenedor siempre
# escucha internamente en 8321).
STLFILES_PORT=8321

# Directorio del host para modelos subidos y jobs generados.
STLFILES_DATA=./data
